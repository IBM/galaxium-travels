<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.galaxium</groupId>
    <artifactId>galaxium-travels</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Galaxium Travels</name>
    <description>
        Aggregator POM — lets Maven tooling discover the Java submodule from the
        workspace root. The hold service lives in booking_system_inventory_hold_service/
        and keeps its own spring-boot-starter-parent. This POM adds no dependencies;
        it only provides reactor ordering, environment guards, and the Maven wrapper.
    </description>

    <!--
        Run from the workspace root:
          ./mvnw test                               — run all Java tests
          ./mvnw test -pl booking_system_inventory_hold_service — single module
          ./mvnw package -DskipTests               — build the war
    -->

    <modules>
        <module>booking_system_inventory_hold_service</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Skip Surefire on the aggregator itself — it has no sources.
                    Without this, `mvn test` at the root prints "No tests to run"
                    before delegating to the submodule, which is misleading.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                    <configuration>
                        <skipTests>true</skipTests>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Enforcer: fail fast if the environment is incompatible before
                any compilation or test execution begins.
                - Java 8+ required (legacy hold service targets 1.8).
                - Maven 3.8+ required for reliable multi-module reactor support.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[1.8,)</version>
                                    <message>Java 8 or higher is required to build the hold service.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.8,)</version>
                                    <message>Maven 3.8 or higher is required. Run ./mvnw instead of mvn to use the pinned version.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
