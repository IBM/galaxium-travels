{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trust Boundary Audit",
          "informationUri": "https://owasp.org/www-project-application-security-verification-standard/",
          "rules": [
            {
              "id": "ASVS-V5.1.2",
              "shortDescription": {
                "text": "Frameworks protect against mass parameter assignment."
              }
            },
            {
              "id": "ASVS-V5.1.3",
              "shortDescription": {
                "text": "All input is validated against an allow list."
              }
            },
            {
              "id": "ASVS-V11.1.4",
              "shortDescription": {
                "text": "The application limits excessive business requests."
              }
            },
            {
              "id": "ASVS-V11.1.5",
              "shortDescription": {
                "text": "The application has business logic limits that protect against likely abuse."
              }
            }
          ]
        }
      },
      "properties": {
        "note": "STAND-IN: replace with the SARIF report from the module 7 authoring run."
      },
      "results": [
        {
          "ruleId": "ASVS-V11.1.4",
          "level": "error",
          "message": {
            "text": "flight_ids has no length cap, so one request can try to hold seats on hundreds of flights. Fix: require 1 to 3 flight IDs in ItineraryCreate."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/schemas.py"
                },
                "region": {
                  "startLine": 110
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASVS-V11.1.4",
          "level": "warning",
          "message": {
            "text": "A user can create any number of held itineraries and keep seats locked. Fix: limit each user to 3 held itineraries within the hold duration and return HTTP 429."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/services/itinerary.py"
                },
                "region": {
                  "startLine": 157
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASVS-V5.1.3",
          "level": "warning",
          "message": {
            "text": "The confirm endpoint never checks that the itinerary belongs to the caller. Fix: verify ownership once the app has authentication."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/server.py"
                },
                "region": {
                  "startLine": 282
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASVS-V5.1.2",
          "level": "error",
          "message": {
            "text": "/internal/bookings/from-hold accepts a raw dict with no schema, so any caller can book as any user. Fix: validate the body with a Pydantic model and restrict the endpoint to the hold service."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/server.py"
                },
                "region": {
                  "startLine": 308
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
